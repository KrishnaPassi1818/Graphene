# Copy to .env for local configuration. Do not commit real secrets.
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
WEB_ORIGIN_DOCKER=http://localhost:8080

# Demo mode seeds a sample dispatcher account and permits local demo requests without login.
# Set DEMO_MODE=false in production; then valid JWT auth is required for private routes.
DEMO_MODE=true
ALLOW_SIGNUP=false
DEMO_EMAIL=dispatcher@routecraft.local
DEMO_PASSWORD=RouteDemo!2026
# Optional bootstrap admin (both values required, password minimum 12 characters).
ADMIN_EMAIL=
ADMIN_PASSWORD=
JWT_SECRET=local-compose-secret-change-before-public-deploy-2026
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false

# Optional persistence and cache. Leave blank for the zero-setup in-memory demo.
# Local Compose fallback only; replace for any shared environment.
POSTGRES_PASSWORD=courier_dev_password
DATABASE_URL=
PG_SSL=false
PG_SSL_REJECT_UNAUTHORIZED=true
REDIS_URL=

# Optional map / routing provider slots. The demo runs on Haversine and needs no API keys.
# Keep secrets on the server; never put private keys in VITE_* variables.
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAPTILER_API_KEY=
OSRM_BASE_URL=
OSRM_API_KEY=
GEOCODING_API_KEY=
